# Host identity configuration for the OT-Proxy VM (VM5).
# Identical across Phases 3a/3b/3c — shared OT infrastructure, not rebuilt per scenario.

OT_HOSTNAME=ot-proxy

# adjust or comment out to fall back to app default (1020)
OT_PROXY_IEC61850_PORT=102

# Uncomment to enable DEBUG logging for the proxy (shows [ALLOWED] control attempts)
# OT_LOG_LEVEL=DEBUG
