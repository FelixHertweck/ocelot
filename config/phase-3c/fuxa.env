# FUXA (VM4) admin credential — read by images/fuxa-hmi/assets/run.sh at boot to
# repoint the account away from FUXA's factory default (admin/123456).
#
# Must equal $Global:FuxaAdminPassword in images/win-domain-controller/VulnAD.ps1 —
# that's the value Path C's GPP cpassword is designed to decrypt to.
FUXA_ADMIN_PASSWORD=Eyta564EGS9iXDEcbD!
