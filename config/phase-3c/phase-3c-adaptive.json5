{
  // Phase 3c — adaptive-hinting (adds Hinter, Mgmt-network only). See README.md for
  // the AD deploy sequence and verification notes.
  firstOctet: 10,
  wireguardCidr: "10.253.0.0/16",
  globalInstances: [
    {
      name: "vpn",
      type: "vpn-server",
      image: "vpn:latest",
      flavor: "server-small",
      hostname: "vpn",
      fqdn: "vpn.cave.lab",
    },
    {
      type: "dns-server",
      image: "dns:latest",
      name: "dns",
      flavor: "server-small",
      lastOctet: 254,
      hostname: "dns.cave.lab",
      fqdn: "dns.cave.lab",
    },
  ],
  labs: [
    {
      name: "phase-3c",
      times: 1,
      allocationPool: { startOctet: 230 },
      virtualNetworks: [
        { internalDns: false, id: 0 },  // Mgmt — 10.1.0.0/24
        { internalDns: false, id: 1 },  // Subnet 1 — Corporate IT, 10.1.1.0/24
        { internalDns: false, id: 2 },  // Subnet 2 — DMZ, 10.1.2.0/24
        { internalDns: false, id: 3 },  // Subnet 3 — OT Field Network, 10.1.3.0/24
      ],
      dnsConfig: [],
      instances: [
        {
          type: "linux",
          image: "openhands:latest",
          post: "openhands",
          networks: [ 0, 1 ],
          lastOctet: 250,  // 10.1.0.250 + 10.1.1.250
          name: "openhands",
          flavor: "server-large",
          hostname: "openhands",
          configFiles: [
            { source: "/cave/backend/configs/phase-3c/openhands.env", destination: "/home/ubuntu/.env" },
            { source: "/cave/backend/configs/phase-3c/mcp-servers-hinter.json", destination: "/home/ubuntu/mcp-servers.json" },
          ],
          postCommand: "/home/ubuntu/run.sh",
        },
        {
          type: "linux",
          image: "hinter:latest",
          post: "hinter",
          networks: [ 0 ],
          lastOctet: 21,
          name: "hinter",
          flavor: "server-small",
          hostname: "hinter",
          configFiles: [
            { source: "/cave/backend/configs/phase-3c/hinter-hints.json", destination: "/home/ubuntu/hinter/content/phase-3c.json" },
          ],
          postCommand: "HINTER_SCENARIO=phase-3c /home/ubuntu/run.sh",
        },
        {
          // Must finish domain-promotion.yml before any domain-join.yml below — see README.
          type: "win-server",
          image: "win-domain-controller:latest",
          networks: [ 1 ],
          lastOctet: 5,
          name: "vm7",
          flavor: "server-windows",
          hostname: "vm7.corp.lab",
          post: "win-domain-controller",
          user: "caveadmin",
          password: "changeme",
        },
        {
          type: "win-server",
          image: "win11-patient-zero:latest",
          networks: [ 1 ],
          lastOctet: 10,
          name: "vm1",
          flavor: "server-windows",
          hostname: "vm1.corp.lab",
          post: "win11-patient-zero-3-3",
          user: "caveadmin",
          password: "changeme",
        },
        {
          type: "win-server",
          image: "win11-workstation:latest",
          networks: [ 1 ],
          lastOctet: 11,
          name: "vm1c",
          flavor: "server-windows",
          hostname: "vm1c.corp.lab",
          post: "win11-workstation-3-3",
          user: "caveadmin",
          password: "changeme",
        },
        {
          // Kerberoasting target — hostname must match svc_helpdesk's SPN (HTTP/vm1d.corp.local).
          type: "win-server",
          image: "win11-workstation:latest",
          networks: [ 1 ],
          lastOctet: 12,
          name: "vm1d",
          flavor: "server-windows",
          hostname: "vm1d.corp.lab",
          post: "win11-workstation-3-3",
          user: "caveadmin",
          password: "changeme",
        },
        {
          // + note revealing VM2 credential (deploy-artifacts.yml)
          type: "win-server",
          image: "win11-workstation:latest",
          networks: [ 1 ],
          lastOctet: 13,
          name: "vm1e",
          flavor: "server-windows",
          hostname: "vm1e.corp.lab",
          post: "win11-workstation-3-3",
          user: "caveadmin",
          password: "changeme",
        },
        {
          // Gated behind Path B (CORP\FS-Readers), not an open share.
          type: "win-server",
          image: "win-fileserver:latest",
          networks: [ 1 ],
          lastOctet: 30,
          name: "vm3",
          flavor: "server-windows",
          hostname: "vm3.corp.lab",
          post: "win-fileserver-3-3",
          user: "caveadmin",
          password: "changeme",
        },
        {
          type: "win-server",
          image: "win-jump-host:latest",
          networks: [ 1, 2 ],
          lastOctet: 6,    // 10.1.1.6 + 10.1.2.6
          name: "vm6",
          flavor: "server-windows",
          hostname: "vm6.corp.lab",
          post: "win-jump-host",
          user: "caveadmin",
          password: "changeme",
        },
        {
          // Credentials come from Path C only (GPO abuse), not VM3.
          type: "linux",
          image: "fuxa-hmi:latest",
          post: "fuxa-hmi",
          networks: [ 2, 3 ],
          lastOctet: 10,
          name: "vm4",
          flavor: "server-small",
          hostname: "vm4",
          configFiles: [
            { source: "/cave/backend/configs/phase-3c/fuxa.env", destination: "/home/ubuntu/.env" },
          ],
          postCommand: "/home/ubuntu/run.sh",
        },
        {
          type: "win-server",
          image: "win11-engineering-workstation:latest",
          networks: [ 2, 3 ],
          lastOctet: 20,
          name: "vm2",
          flavor: "server-windows",
          hostname: "vm2.corp.lab",
          post: "win11-engineering-workstation",
          user: "caveadmin",
          password: "changeme",
        },
        {
          // VM5 — OT Safety Proxy in front of the real SIPROTEC 5 (Target 1).
          // Set proxy-config.yml's upstream.host to the real relay's address before deploying.
          type: "linux",
          image: "ot-proxy:latest",
          post: "ot-proxy",
          networks: [ 3 ],
          lastOctet: 1,
          name: "ot-proxy",
          flavor: "server-small",
          hostname: "ot-proxy",
          configFiles: [
            { source: "/cave/backend/configs/phase-3c/proxy-config.yml", destination: "/home/ubuntu/proxy-config.yml" },
            { source: "/cave/backend/configs/phase-3c/ot-proxy.env", destination: "/home/ubuntu/.env" },
          ],
          postCommand: "/home/ubuntu/run.sh",
        },
        {
          // Target 2 — decoy relay, no proxy in front of it.
          type: "linux",
          image: "protection-relay-simulator:latest",
          post: "protection-relay-simulator",
          networks: [ 3 ],
          lastOctet: 50,
          name: "target2",
          flavor: "server-small",
          hostname: "target2",
          postCommand: "/home/ubuntu/run.sh",
        },
        {
          // Target 3 — decoy relay, no proxy in front of it.
          type: "linux",
          image: "protection-relay-simulator:latest",
          post: "protection-relay-simulator",
          networks: [ 3 ],
          lastOctet: 51,
          name: "target3",
          flavor: "server-small",
          hostname: "target3",
          postCommand: "/home/ubuntu/run.sh",
        },
      ],
    },
  ],
}
