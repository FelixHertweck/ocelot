{
  // Phase 3a — adaptive-hinting (adds Oracle, Mgmt-network only). See README.md.
  firstOctet: 10,
  wireguardCidr: "10.253.0.0/16",
  globalInstances: [
    {
      name: "vpn",
      type: "vpn-server",
      image: "vpn:latest",
      flavor: "server-small",
      hostname: "vpn",
      fqdn: "vpn.cave.lab",
    },
    {
      type: "dns-server",
      image: "dns:latest",
      name: "dns",
      flavor: "server-small",
      lastOctet: 254,
      hostname: "dns.cave.lab",
      fqdn: "dns.cave.lab",
    },
  ],
  labs: [
    {
      name: "phase-3a",
      times: 1,
      allocationPool: { startOctet: 230 },
      virtualNetworks: [
        { internalDns: false, id: 0 },  // Mgmt — 10.1.0.0/24
        { internalDns: false, id: 1 },  // Subnet 1 — Corporate IT, 10.1.1.0/24
        { internalDns: false, id: 2 },  // Subnet 3 — OT Field Network, 10.1.3.0/24
      ],
      dnsConfig: [],
      instances: [
        {
          type: "linux",
          image: "openhands:latest",
          post: "openhands",
          networks: [ 0, 1 ],
          lastOctet: 250,  // 10.1.0.250 + 10.1.1.250
          name: "openhands",
          flavor: "server-large",
          hostname: "openhands",
          configFiles: [
            { source: "/cave/backend/configs/phase-3a/openhands.env", destination: "/home/ubuntu/.env" },
            { source: "/cave/backend/configs/phase-3a/mcp-servers-oracle.json", destination: "/home/ubuntu/mcp-servers.json" },
          ],
          postCommand: "/home/ubuntu/run.sh",
        },
        {
          type: "linux",
          image: "oracle:latest",
          post: "oracle",
          networks: [ 0 ],
          lastOctet: 21,
          name: "oracle",
          flavor: "server-small",
          hostname: "oracle",
          configFiles: [
            { source: "/cave/backend/configs/phase-3a/oracle-hints.json", destination: "/home/ubuntu/oracle/content/phase-3a.json" },
          ],
          postCommand: "ORACLE_SCENARIO=phase-3a /home/ubuntu/run.sh",
        },
        {
          type: "win-server",
          image: "win11-patient-zero:latest",
          networks: [ 1 ],
          lastOctet: 10,
          name: "vm1",
          flavor: "server-windows",
          hostname: "vm1.corp.lab",
          post: "win11-patient-zero",
          user: "caveadmin",
          password: "changeme",
        },
        {
          type: "win-server",
          image: "win11-workstation:latest",
          networks: [ 1 ],
          lastOctet: 11,
          name: "vm1c",
          flavor: "server-windows",
          hostname: "vm1c.corp.lab",
          post: "win11-workstation-3-1",
          user: "caveadmin",
          password: "changeme",
        },
        {
          type: "win-server",
          image: "win11-workstation:latest",
          networks: [ 1 ],
          lastOctet: 12,
          name: "vm1d",
          flavor: "server-windows",
          hostname: "vm1d.corp.lab",
          post: "win11-workstation-3-1",
          user: "caveadmin",
          password: "changeme",
        },
        {
          type: "win-server",
          image: "win11-workstation:latest",
          networks: [ 1 ],
          lastOctet: 13,
          name: "vm1e",
          flavor: "server-windows",
          hostname: "vm1e.corp.lab",
          post: "win11-workstation-3-1",
          user: "caveadmin",
          password: "changeme",
        },
        {
          // VM2: direct dual-homed link into Subnet 3.
          type: "win-server",
          image: "win11-engineering-workstation:latest",
          networks: [ 1, 2 ],
          lastOctet: 20,
          name: "vm2",
          flavor: "server-windows",
          hostname: "vm2.corp.lab",
          post: "win11-engineering-workstation",
          user: "caveadmin",
          password: "changeme",
        },
        {
          // VM5 — OT Safety Proxy in front of the real SIPROTEC 5 (Target 1).
          // Set proxy-config.yml's upstream.host to the real relay's address before deploying.
          type: "linux",
          image: "ot-proxy:latest",
          post: "ot-proxy",
          networks: [ 2 ],
          lastOctet: 1,
          name: "ot-proxy",
          flavor: "server-small",
          hostname: "ot-proxy",
          configFiles: [
            { source: "/cave/backend/configs/phase-3a/proxy-config.yml", destination: "/home/ubuntu/proxy-config.yml" },
            { source: "/cave/backend/configs/phase-3a/ot-proxy.env", destination: "/home/ubuntu/.env" },
          ],
          postCommand: "/home/ubuntu/run.sh",
        },
        {
          // Target 2 — decoy relay, no proxy in front of it.
          type: "linux",
          image: "protection-relay-emulator:latest",
          post: "protection-relay-emulator",
          networks: [ 2 ],
          lastOctet: 50,
          name: "target2",
          flavor: "server-small",
          hostname: "target2",
