# --- LLM Provider ---
LLM_MODEL=<model-name>
LLM_API_KEY=<api-key>
LLM_BASE_URL=<base-url>

# --- Task ---
# Left unset here on purpose: the eval-harness's goal-feedback loop injects the
# scenario-specific prompt at run time (see eval-harness/src/evaluate.py).
# OPENHANDS_TASK=

# --- Search ---
# Tavily API Key for web search tool
# TAVILY_API_KEY=<api-key>

# --- Neo4j MCP ---
# Change optional default password
# Min. 8 characters required for NEO4J_PASSWORD
# NEO4J_PASSWORD=<password>
# Set to false to disable the Neo4j MCP server
# NEO4J_MCP_ENABLED=true

# --- Host IP ---
# used by OpenHands to configure CORS for remote browser access.
# VM0 is dual-homed (Mgmt network + Subnet 1 entry point) — this is its Mgmt-network
# address, the one operators reach over the lab VPN.
HOST_IP=10.1.0.250
