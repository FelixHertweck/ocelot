{
  firstOctet: 10,
  wireguardCidr: "10.253.0.0/16",
  globalInstances: [
    {
      name: "vpn",
      type: "vpn-server",
      image: "vpn:latest",
      flavor: "server-small",
      hostname: "vpn",
      fqdn: "vpn.cave.lab",
    },
    {
      type: "dns-server",
      image: "dns:latest",
      name: "dns",
      flavor: "server-small",
      lastOctet: 254,
      hostname: "dns.cave.lab",
      fqdn: "dns.cave.lab",
    },
  ],
  labs: [
    {
      name: "phase-1c",
      times: 1,
      // Pool moved above all fixed IPs (.10-.20) to avoid IpAddressAlreadyAllocated.
      allocationPool: { startOctet: 100 },
      virtualNetworks: [
        {
          internalDns: false,
          id: 1,
        },
      ],
      dnsConfig: [],
      instances: [
        {
          type: "linux",
          image: "inverter-emulator:latest",
          post: "inverter-emulator",
          networks: [ 1 ],
          lastOctet: 10,
          macAddress: null,
          name: "inverter-emulator",
          flavor: "server-small",
          hostname: "inverter-emulator",
          postCommand: "/home/ubuntu/run.sh",
        },
        {
          type: "linux",
          image: "openhands:latest",
          post: "openhands",
          networks: [ 1 ],
          lastOctet: 20,
          name: "openhands",
          // For larger instances, if want more conversations at a time use bigger flavor
          // flavor: "server-xlarge",
          flavor: "server-large",
          hostname: "openhands",
          configFiles: [
            { source: "/cave/backend/configs/shared/openhands/openhands.env", destination: "/home/ubuntu/.env" },
            { source: "/cave/backend/configs/shared/openhands/mcp-servers-oracle.json", destination: "/home/ubuntu/mcp-servers.json" },
          ],
          postCommand: "/home/ubuntu/run.sh",
        },
        // Hint service: on-demand Oracle for the attacker, reached over MCP
        // (Streamable HTTP). Shares network 1 with openhands in this simple lab.
        {
          type: "linux",
          image: "oracle:latest",
          post: "oracle",
          networks: [ 1 ],
          lastOctet: 21,
          name: "oracle",
          flavor: "server-small",
          hostname: "oracle",
          configFiles: [
            // Per-scenario hint content, mounted as ~/oracle/content/phase-1c.json to match
            // ORACLE_SCENARIO (set on run.sh below — no .env is shipped for this VM).
            { source: "/cave/backend/configs/phase-1c/oracle-hints.json", destination: "/home/ubuntu/oracle/content/phase-1c.json" },
          ],
          postCommand: "ORACLE_SCENARIO=phase-1c /home/ubuntu/run.sh",
        },
      ],
    },
  ],
}
