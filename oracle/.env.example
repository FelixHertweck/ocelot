# Copy to .env for local `docker compose up` runs. Real per-scenario deployment config is
# authored separately.

# --- Which variant this instance runs ---
ORACLE_VARIANT=A
ORACLE_RUN_ID=dev
ORACLE_SCENARIO=scenario-3.1

# --- Variant A only: CTFd backend ---
CTFD_URL=http://host.docker.internal:8000
CTFD_USERNAME=
CTFD_PASSWORD=

# --- Variant B only: oracle LLM ---
# Use a different model/account than the attacker LLM's.
ORACLE_LLM_MODEL=
ORACLE_LLM_API_KEY=
ORACLE_LLM_BASE_URL=
